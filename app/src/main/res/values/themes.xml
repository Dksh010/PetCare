<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App theme: Material 3 light with the PetCare palette, Poppins type and component styles. -->
    <style name="Base.Theme.PetCare" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/accent</item>

        <!-- Surfaces (container roles pinned so Material does not tint them purple) -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <!-- Keep raised surfaces pure white instead of tinting them with the primary color -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- System bars blend with the cream background -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Typography: Poppins everywhere -->
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.PetCare.Display</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PetCare.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.PetCare.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PetCare.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PetCare.Subtitle</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.PetCare.Body.Medium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PetCare.Subtitle</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PetCare.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.PetCare.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PetCare.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.PetCare.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.PetCare.Label</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PetCare.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PetCare.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PetCare.LargeComponent</item>

        <!-- Default component styles -->
        <item name="materialButtonStyle">@style/Widget.PetCare.Button</item>
        <item name="materialCardViewStyle">@style/Widget.PetCare.Card</item>
        <item name="textInputStyle">@style/Widget.PetCare.TextField</item>
        <item name="chipStyle">@style/Widget.PetCare.Chip.Filter</item>
        <item name="bottomNavigationStyle">@style/Widget.PetCare.BottomNavigation</item>
        <item name="floatingActionButtonStyle">@style/Widget.PetCare.FloatingActionButton</item>
        <item name="toolbarStyle">@style/Widget.PetCare.Toolbar</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.PetCare.Progress</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PetCare.MaterialAlertDialog</item>
    </style>

    <style name="Theme.PetCare" parent="Base.Theme.PetCare" />

    <!-- Splash Screen Theme -->
    <style name="Theme.PetCare.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PetCare</item>
    </style>
</resources>
