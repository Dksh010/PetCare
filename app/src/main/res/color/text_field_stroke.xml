<?xml version="1.0" encoding="utf-8"?>
<!-- Input outline: brand color when focused, red on error, soft outline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/primary" android:state_focused="true" />
    <item android:color="@color/text_hint" android:state_hovered="true" />
    <item android:color="@color/outline" android:state_enabled="false" />
    <item android:color="@color/outline" />
</selector>
