<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: logo tile, name and tagline on the warm brand gradient. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_2xl">

    <LinearLayout
        android:id="@+id/tvSplashMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:elevation="@dimen/elevation_raised"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.PetCare.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/app_tagline"
            android:textAppearance="@style/TextAppearance.PetCare.Body.Secondary" />
    </LinearLayout>
</LinearLayout>
