<?xml version="1.0" encoding="utf-8"?>
<!-- Add-pet wizard: progress header, 5 steps, Back / Continue footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.pets.AddPetWizardActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_2xl"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/tvWizardStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.PetCare.Label"
            android:textColor="@color/primary"
            tools:text="Step 1 of 5" />

        <TextView
            android:id="@+id/tvWizardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.PetCare.Headline"
            tools:text="Pet type" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pbWizardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:max="5"
            app:trackColor="@color/surface"
            tools:progress="1" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:id="@+id/stepContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- Step 1: species -->
            <LinearLayout
                android:id="@+id/layoutStepType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/PetCare.Text.Supporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wizard_type_prompt" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSpecies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:chipSpacingHorizontal="@dimen/space_sm"
                    app:chipSpacingVertical="@dimen/space_sm"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDog"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="🐶 Dog" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCat"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐱 Cat" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRabbit"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐰 Rabbit" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHamster"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐹 Hamster" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBird"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐦 Bird" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFish"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐠 Fish" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTurtle"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐢 Turtle" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReptile"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🦎 Reptile" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOther"
                        style="@style/Widget.PetCare.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐾 Other" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Step 2: basics + photo -->
            <LinearLayout
                android:id="@+id/layoutStepBasic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivWizardPetPhoto"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@color/primary_container"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Avatar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWizardChoosePhoto"
                    style="@style/Widget.PetCare.Button.Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/add_photo"
                    app:icon="@drawable/ic_camera" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetCare.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/hint_pet_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWizardName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetCare.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/hint_pet_breed">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWizardBreed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PetCare.TextField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:hint="@string/hint_pet_age">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWizardAge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PetCare.TextField.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_gender">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etWizardGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/pet_genders" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 3: physical -->
            <LinearLayout
                android:id="@+id/layoutStepPhysical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetCare.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_weight_example">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWizardWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetCare.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/hint_fur_color">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWizardFurColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.PetCare.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:contentPaddingBottom="@dimen/space_xs"
                    app:contentPaddingTop="@dimen/space_xs">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbWizardSterilized"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sterilized"
                        android:textAppearance="@style/TextAppearance.PetCare.Body.Medium" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Step 4: health -->
            <LinearLayout
                android:id="@+id/layoutStepHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetCare.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_dietary_prefs">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWizardDiet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetCare.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/hint_allergies">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWizardAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetCare.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/hint_vet_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWizardVetInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Step 5: review -->
            <LinearLayout
                android:id="@+id/layoutStepReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.PetCare.Card.Tinted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:contentPadding="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_review_title"
                            android:textAppearance="@style/TextAppearance.PetCare.Title" />

                        <TextView
                            android:id="@+id/tvReviewSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:lineSpacingExtra="6dp"
                            android:textAppearance="@style/TextAppearance.PetCare.Body"
                            tools:text="Name: Max\nSpecies: Dog" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_raised"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardPrev"
            style="@style/Widget.PetCare.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardNext"
            style="@style/Widget.PetCare.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/continue_label" />
    </LinearLayout>
</LinearLayout>
