<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayoutMap"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/near_black"
    tools:context=".ui.map.PetMapActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarMap"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/pet_map"
        app:titleTextColor="@color/primary_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarMap">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Nearby"
            android:textColor="@color/primary_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Discover high-quality local veterinary clinics, premium grooming salons, dog parks, and shelters around your area."
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <!-- Developer Isolation Instructions -->
        <!--
            TODO: Google Maps SDK dependency inclusion
            TODO: local.properties API Key mapping configuration
            TODO: SupportMapFragment instantiation element
            TODO: Runtime location precision permissions handling
            TODO: Marker generation logic implementation
            TODO: Places category API filter controls
        -->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>