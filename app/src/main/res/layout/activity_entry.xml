<?xml version="1.0" encoding="utf-8"?>
<!-- Entry / welcome screen: illustration, value proposition, Create account + Sign in. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient"
    android:fillViewport="true"
    tools:context=".ui.auth.EntryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_2xl">

        <LinearLayout
            android:id="@+id/entry_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Illustration: paw in a warm circle with floating feature badges -->
            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="260dp">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/surface"
                    android:contentDescription="@null"
                    android:padding="56dp"
                    android:src="@drawable/ic_paw"
                    app:tint="@color/primary" />

                <ImageView
                    android:layout_width="@dimen/icon_tile_lg"
                    android:layout_height="@dimen/icon_tile_lg"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="@dimen/space_xl"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="@color/info_container"
                    android:contentDescription="@null"
                    android:elevation="@dimen/elevation_card"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_appointment"
                    app:tint="@color/info" />

                <ImageView
                    android:layout_width="@dimen/icon_tile_lg"
                    android:layout_height="@dimen/icon_tile_lg"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="@color/success_container"
                    android:contentDescription="@null"
                    android:elevation="@dimen/elevation_card"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_vaccination"
                    app:tint="@color/success" />

                <ImageView
                    android:layout_width="@dimen/icon_tile_lg"
                    android:layout_height="@dimen/icon_tile_lg"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/space_md"
                    android:layout_marginBottom="@dimen/space_md"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="@color/warning_container"
                    android:contentDescription="@null"
                    android:elevation="@dimen/elevation_card"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_reminder"
                    app:tint="@color/warning" />

                <ImageView
                    android:layout_width="@dimen/icon_tile_lg"
                    android:layout_height="@dimen/icon_tile_lg"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="@color/primary_container"
                    android:contentDescription="@null"
                    android:elevation="@dimen/elevation_card"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.PetCare.Title"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/entry_title"
                android:textAppearance="@style/TextAppearance.PetCare.Display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/entry_subtitle"
                android:textAppearance="@style/TextAppearance.PetCare.Body.Secondary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            style="@style/Widget.PetCare.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="@string/btn_get_started" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.PetCare.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/btn_have_account" />
    </LinearLayout>
</ScrollView>
